{
	"name": "@nocoo/basalt",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"build:css": "bun ../../scripts/build-basalt-standalone.ts"
	},
	"sideEffects": [
		"*.css"
	],
	"exports": {
		".": "./src/index.ts",
