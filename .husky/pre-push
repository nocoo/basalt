#!/usr/bin/env sh

# System0 pre-push entry point. The supervisor owns the hard deadline and kills
# the whole hook process tree; scripts/quality/hook-pre-push.sh holds the hook
# body.
set -e

command -v bun >/dev/null 2>&1 || { echo "pre-push: bun is required" >&2; exit 1; }

exec bun run scripts/quality/supervisor.ts --hook=pre-push
